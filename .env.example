# datavibes secrets — copy to `.env` and fill in.
#
# `.env` is gitignored and loaded at SDK/CLI startup BEFORE any ${VAR}
# interpolation. Real process environment variables ALWAYS win over `.env`
# (the loader never overwrites an already-set variable).

# --- Secrets (only needed for live source fetches; tests mock the network) ---
# NOAA NCEI/NCDC Climate Data Online web-service token (request at
# https://www.ncdc.noaa.gov/cdo-web/token). NCEI_TOKEN is accepted as an alias.
NCDC_WEB_SERVICE_TOKEN=your-noaa-ncdc-web-service-token
OPENWEATHERMAP_API_KEY=your-owm-api-key        # OpenWeatherMap API key (optional freshener)

# --- Non-secret runtime knobs (optional; config.yaml supplies defaults) ---
DATAVIBES_USER_AGENT=datavibes/0.1 (+https://example.org)   # HTTP User-Agent for polite fetching

# Absolute path to the dataset-output directory. OPTIONAL — when unset the
# config.yaml paths.output_root (default `output/`) applies. Overrides
# config.yaml; a relative value is resolved against the project root.
# DATAVIBES_OUTPUT_DIR=/abs/path/to/dataset-output
